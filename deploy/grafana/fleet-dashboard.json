{
  "uid": "attune-fleet",
  "title": "Attune Fleet (multi-cluster)",
  "tags": [
    "attune",
    "fleet",
    "multi-cluster"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(attune_resize_total, cluster)",
        "query": "label_values(attune_resize_total, cluster)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "description": "Requires Prometheus external_labels.cluster. Use All when unset."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Resize success rate by cluster",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (cluster) (rate(attune_resize_total{result=\"success\",cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Requires Prometheus external_labels.cluster on each cluster scrape. Without that label, panels may be empty; set cluster identity or use per-cluster dashboard."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Resize failures by cluster",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (cluster) (rate(attune_resize_total{result=\"failed\",cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reverts by cluster",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (cluster) (rate(attune_reverts_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Estimated monthly savings (USD) by cluster",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (cluster) (attune_savings_estimated_monthly_dollars{cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "CPU savings cores by cluster",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (cluster) (attune_savings_cpu_cores_total{cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Memory savings bytes by cluster",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (cluster) (attune_savings_memory_bytes_total{cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Fleet report export failures",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(attune_fleet_report_export_total{result=\"failed\"}[5m]))",
          "legendFormat": "failures",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Org rollup: resize total by result",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(attune_resize_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    }
  ]
}
